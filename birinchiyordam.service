[Unit]
Description=Birinchi Yordam Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/Birinchi-Yordam-bot
ExecStart=/root/Birinchi-Yordam-bot/venv/bin/python -u run_dev.py
Restart=always
RestartSec=10
Environment="PATH=/root/Birinchi-Yordam-bot/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="PYTHONUNBUFFERED=1"
EnvironmentFile=/root/Birinchi-Yordam-bot/.env

[Install]
WantedBy=multi-user.target
